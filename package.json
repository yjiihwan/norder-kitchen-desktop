{
  "name": "norder-kitchen",
  "productName": "N오더 주방",
  "version": "0.1.1",
  "private": true,
  "description": "N오더 식당(점주·주방)용 주문 접수 데스크톱 앱 — staging 전용",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --universal -c.productName='NOrder Kitchen' '-c.mac.extendInfo.CFBundleDisplayName=N오더 주방'"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "kr.co.ngym.norder.kitchen",
    "productName": "N오더 주방",
    "afterPack": "build/adhoc-sign.js",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NOrder-Kitchen-Setup-${version}.exe",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "NOrder-Kitchen-${version}-${arch}.dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.business"
    },
    "dmg": {
      "writeUpdateInfo": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "N오더 주방"
    }
  }
}
