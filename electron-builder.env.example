# ─────────────────────────────────────────────────────────────
# macOS 서명·공증 자격증명 (로컬 빌드용)
# 이 파일을 `electron-builder.env` 로 복사해 값을 채운다. electron-builder가 빌드 시 자동 로드한다.
# `electron-builder.env` 는 .gitignore 되어 있다 — 절대 커밋하지 말 것.
# 비어 있으면 서명·공증을 건너뛰고 ad-hoc 서명 dmg가 나온다(기존 흐름).
# ─────────────────────────────────────────────────────────────

# [A] Developer ID Application 인증서(.p12) — 둘 중 하나:
#   A-1) 파일을 base64 로 인코딩한 값 또는 파일 절대경로
CSC_LINK=
#   A-2) .p12 내보내기 비밀번호
CSC_KEY_PASSWORD=
#   (대안) 인증서를 이 맥 로그인 키체인에 직접 설치했다면 CSC_LINK 없이 자동 탐색됨 — 아래 두 줄은 비워둔다

# [B] 공증(notarization) — B-1 또는 B-2 중 하나만 채운다
#   B-1) Apple ID + 앱 암호(appleid.apple.com → 로그인 및 보안 → 앱 암호) + Team ID(developer.apple.com → Membership)
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
#   B-2) App Store Connect API 키(권장) — .p8 파일 절대경로 / Key ID / Issuer ID
# APPLE_API_KEY=
# APPLE_API_KEY_ID=
# APPLE_API_ISSUER=
